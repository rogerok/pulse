{
  "defaults": {
    "interval": "30s",
    "jsonlPath": "./src/events.jsonl",
    "name": "pulse",
    "retries": 0,
    "timeout": 5000,
    "writeJsonl": true
  },
  "monitors": [
    {
      "expect": {
        "status": 200
      },
      "fallbackUrl": "https://github.com",
      "id": "github-www",
      "interval": "2s",
      "url": "https://github.com"
    },
    {
      "expect": {
        "status": 200
      },
      "fallbackUrl": "https://github.com",
      "id": "self-api",
      "interval": "2s",
      "url": "https://api.self.local/health"
    },
    {
      "expect": {
        "status": 200
      },
      "fallbackUrl": "https://jsonplaceholder.typicode.com/todos/2",
      "id": "json-todo",
      "interval": "2s",
      "url": "https://jsonplaceholder.typicode.com/todos/1"
    },
    {
      "expect": {
        "status": 200
      },
      "fallbackUrl": "https://jsonplaceholder.typicode.com/posts/2",
      "id": "json-post",
      "interval": "2s",
      "url": "https://jsonplaceholder.typicode.com/posts/1"
    },
    {
      "expect": {
        "status": 200
      },
      "fallbackUrl": "https://jsonplaceholder.typicode.com/users/2",
      "id": "json-user",
      "interval": "2s",
      "url": "https://jsonplaceholder.typicode.com/users/1"
    }
  ]
}